{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luckytinfs",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public/"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "luckytinfs.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NUXT_PUBLIC_SITE_URL": "https://luckytinfs.com"
  }
}
