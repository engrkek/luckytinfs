{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luckytinfs",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": [
    "nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public/"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "luckytinfs.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NUXT_PUBLIC_SITE_URL": "https://luckytinfs.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luckytinfs",
      "database_id": "658bce76-454d-478b-bfa4-bbe20d9bd8f3",
      "migrations_table": "_hub_migrations",
      "migrations_dir": "./server/db/migrations/sqlite/"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "luckytinfs",
      "binding": "BLOB"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c8534e2dc6d64214b4f0e92220429d84"
    }
  ]
}
